generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Inquiry {
  id                String   @id @default(uuid()) @db.Uuid
  idempotencyKey    String   @unique @db.Uuid
  fingerprint       String   @db.VarChar(64)
  name              String   @db.VarChar(100)
  company           String   @db.VarChar(200)
  phone             String   @db.VarChar(40)
  email             String   @db.VarChar(254)
  service           String   @db.VarChar(40)
  task              String   @db.Text
  consentAcceptedAt DateTime @default(now())
  policyVersion     String   @db.VarChar(100)
  consentVersion    String   @db.VarChar(100)
  policyHash        String   @db.VarChar(64)
  consentHash       String   @db.VarChar(64)
  policyText        String   @db.Text
  consentText       String   @db.Text
  createdAt         DateTime @default(now())
  expiresAt         DateTime
  files             InquiryFile[]
  notification      Notification?

  @@index([createdAt, id])
  @@index([expiresAt])
}

model InquiryFile {
  id          String  @id @default(uuid()) @db.Uuid
  inquiryId   String  @db.Uuid
  inquiry     Inquiry @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  originalName String @db.VarChar(180)
  storageKey  String  @unique @db.VarChar(100)
  mime        String  @db.VarChar(80)
  size        Int
  sha256      String  @db.VarChar(64)
}

model Notification {
  id            String   @id @default(uuid()) @db.Uuid
  inquiryId     String   @unique @db.Uuid
  inquiry       Inquiry  @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  status        String   @default("PENDING") @db.VarChar(30)
  attempts      Int      @default(0)
  nextAttemptAt DateTime @default(now())
  leaseUntil    DateTime?
  lastErrorCode String?  @db.VarChar(50)
  sentAt        DateTime?

  @@index([status, nextAttemptAt])
}

model RateLimit {
  key       String   @id @db.VarChar(120)
  hits      Int
  expiresAt DateTime

  @@index([expiresAt])
}

model AccessAudit {
  id        String   @id @default(uuid()) @db.Uuid
  action    String   @db.VarChar(30)
  reference String?  @db.Uuid
  createdAt DateTime @default(now())

  @@index([createdAt])
}
